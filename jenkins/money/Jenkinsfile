/**
 * Jenkins job: Airpay Money (phone)
 * Script Path: jenkins/money/Jenkinsfile
 *
 * Windows agent with the phone attached. Missing JDK, Maven, Android SDK, Appium,
 * and the UiAutomator2 driver are installed, and Appium is started when it is down.
 */
def helpers

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '6', daysToKeepStr: '14'))
        timeout(time: 4, unit: 'HOURS')
    }

    parameters {
        choice(name: 'ENV', choices: ['live', 'staging'], description: '-Denv')
        choice(name: 'SUITE', choices: ['functional', 'smoke', 'a11y', 'custom'])
        string(name: 'EXTRA_TAGS', defaultValue: '')
        string(name: 'CUCUMBER_TAGS', defaultValue: '')
        string(name: 'ANDROID_UDID', defaultValue: '')
        string(name: 'OTP', defaultValue: '1234', description: 'money.test.otp')
        booleanParam(name: 'CLEAN_PREVIOUS_REPORTS', defaultValue: true)
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'
        JOB_LABEL = 'Airpay Money Mobile'
        MODULE = 'airpay_money'
        PRODUCT = 'money'
        PRODUCT_TAG = '@airpay-money'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script { helpers = load 'jenkins/_lib/pipelineHelpers.groovy' }
            }
        }

        stage('Run tests') {
            steps {
                script {
                    def extra = ''
                    if (params.SUITE == 'a11y') {
                        extra = '-Da11y.crawl.exhaustive=true -Dandroid.keep.session=true -Da11y.fresh.run=true'
                    }
                    def code = helpers.runMobile([
                            module        : env.MODULE,
                            product       : env.PRODUCT,
                            productTag    : env.PRODUCT_TAG,
                            test          : 'MoneyRunner',
                            envName       : params.ENV,
                            suite         : params.SUITE,
                            udid          : params.ANDROID_UDID,
                            otp           : params.OTP,
                            cucumberTags  : params.CUCUMBER_TAGS,
                            extraTags     : params.EXTRA_TAGS,
                            extraMaven    : extra,
                            cleanReports  : params.CLEAN_PREVIOUS_REPORTS
                    ])
                    if (code != 0) {
                        currentBuild.result = 'UNSTABLE'
                        error "Tests failed (exit ${code})"
                    }
                }
            }
        }
    }

    post {
        always {
            script { if (helpers) { helpers.publishAllure(env.PRODUCT) } }
            archiveArtifacts artifacts: 'target/money/**', allowEmptyArchive: true
            junit testResults: 'target/surefire-reports/airpay_money/*.xml', allowEmptyResults: true
        }
    }
}
