/**
 * Jenkins job: Airpay Capital (phone)
 * Script Path: jenkins/capital/Jenkinsfile
 *
 * Windows agent with the phone attached. The run installs JDK 21, Maven, Android
 * platform-tools, Appium, and the UiAutomator2 driver when they are missing, and
 * starts Appium when nothing is listening on port 4723.
 */
def helpers

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '6', daysToKeepStr: '14'))
        timeout(time: 4, unit: 'HOURS')
    }

    parameters {
        choice(name: 'ENV', choices: ['live', 'staging'], description: '-Denv')
        choice(name: 'SUITE', choices: ['functional', 'smoke', 'a11y', 'custom'])
        string(name: 'EXTRA_TAGS', defaultValue: '', description: 'Appended when CUCUMBER_TAGS is empty')
        string(name: 'CUCUMBER_TAGS', defaultValue: '', description: 'Full tag expression. Required when SUITE=custom')
        string(name: 'ANDROID_UDID', defaultValue: '', description: 'Phone serial. Leave empty to use the only connected phone')
        string(name: 'OTP', defaultValue: '1234', description: 'capital.test.otp')
        booleanParam(name: 'CLEAN_PREVIOUS_REPORTS', defaultValue: true)
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'
        JOB_LABEL = 'Airpay Capital Mobile'
        MODULE = 'airpay_capital'
        PRODUCT = 'capital'
        PRODUCT_TAG = '@airpay-capital'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script { helpers = load 'jenkins/_lib/pipelineHelpers.groovy' }
            }
        }

        stage('Run tests') {
            steps {
                script {
                    def extra = (params.SUITE == 'a11y') ? '-Dandroid.keep.session=true' : ''
                    def code = helpers.runMobile([
                            module        : env.MODULE,
                            product       : env.PRODUCT,
                            productTag    : env.PRODUCT_TAG,
                            test          : 'CapitalRunner',
                            envName       : params.ENV,
                            suite         : params.SUITE,
                            udid          : params.ANDROID_UDID,
                            otp           : params.OTP,
                            cucumberTags  : params.CUCUMBER_TAGS,
                            extraTags     : params.EXTRA_TAGS,
                            extraMaven    : extra,
                            cleanReports  : params.CLEAN_PREVIOUS_REPORTS
                    ])
                    if (code != 0) {
                        currentBuild.result = 'UNSTABLE'
                        error "Tests failed (exit ${code})"
                    }
                }
            }
        }
    }

    post {
        always {
            script { if (helpers) { helpers.publishAllure(env.PRODUCT) } }
            archiveArtifacts artifacts: 'target/capital/**', allowEmptyArchive: true
            junit testResults: 'target/surefire-reports/airpay_capital/*.xml', allowEmptyResults: true
        }
    }
}
