/**
 * Copy to jenkins/<product>/Jenkinsfile for a new Android app module.
 * Script Path in Jenkins: jenkins/<product>/Jenkinsfile
 *
 * The Windows agent installs JDK 21, Maven, the Android SDK, Appium, and UiAutomator2
 * when they are missing, then starts Appium if port 4723 is closed.
 */
def helpers

pipeline {
    agent any

    options {
        timeout(time: 4, unit: 'HOURS')
    }

    parameters {
        choice(name: 'ENV', choices: ['live', 'staging'])
        choice(name: 'SUITE', choices: ['functional', 'smoke', 'a11y', 'custom'])
        string(name: 'EXTRA_TAGS', defaultValue: '')
        string(name: 'CUCUMBER_TAGS', defaultValue: '')
        string(name: 'ANDROID_UDID', defaultValue: '')
        booleanParam(name: 'CLEAN_PREVIOUS_REPORTS', defaultValue: true)
    }

    environment {
        MODULE = 'airpay_NEWPRODUCT'
        PRODUCT = 'newproduct'
        PRODUCT_TAG = '@airpay-newproduct'
        MAVEN_OPTS = '-Xmx1024m'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script { helpers = load 'jenkins/_lib/pipelineHelpers.groovy' }
            }
        }
        stage('Run tests') {
            steps {
                script {
                    def code = helpers.runMobile([
                            module       : env.MODULE,
                            product      : env.PRODUCT,
                            productTag   : env.PRODUCT_TAG,
                            test         : 'NewProductRunner',
                            envName      : params.ENV,
                            suite        : params.SUITE,
                            udid         : params.ANDROID_UDID,
                            cucumberTags : params.CUCUMBER_TAGS,
                            extraTags    : params.EXTRA_TAGS,
                            cleanReports : params.CLEAN_PREVIOUS_REPORTS
                    ])
                    if (code != 0) {
                        currentBuild.result = 'UNSTABLE'
                        error "Tests failed (exit ${code})"
                    }
                }
            }
        }
    }

    post {
        always {
            script { if (helpers) { helpers.publishAllure(env.PRODUCT) } }
            archiveArtifacts artifacts: 'target/newproduct/**', allowEmptyArchive: true
        }
    }
}
