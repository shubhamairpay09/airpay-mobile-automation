/**
 * Jenkins job: Airpay Vyaapaar (phone)
 * Script Path: jenkins/vyaapaar/Jenkinsfile
 *
 * Windows agent with the phone attached. The same toolchain setup as Capital and Money
 * runs first. config/secrets.properties on the agent needs vyaapaar.test.password.
 */
def helpers

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '6', daysToKeepStr: '14'))
        timeout(time: 4, unit: 'HOURS')
    }

    parameters {
        choice(name: 'ENV', choices: ['live', 'staging'], description: '-Denv')
        choice(name: 'SUITE', choices: ['a11y', 'smoke', 'functional', 'custom'])
        string(name: 'EXTRA_TAGS', defaultValue: '@deep')
        string(name: 'CUCUMBER_TAGS', defaultValue: '')
        string(name: 'ANDROID_UDID', defaultValue: '')
        booleanParam(name: 'CLEAN_PREVIOUS_REPORTS', defaultValue: false)
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'
        JOB_LABEL = 'Airpay Vyaapaar Mobile'
        MODULE = 'airpay_vyaapaar'
        PRODUCT = 'vyaapaar'
        PRODUCT_TAG = '@airpay-vyaapaar'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script { helpers = load 'jenkins/_lib/pipelineHelpers.groovy' }
            }
        }

        stage('Run tests') {
            steps {
                script {
                    def code = helpers.runMobile([
                            module        : env.MODULE,
                            product       : env.PRODUCT,
                            productTag    : env.PRODUCT_TAG,
                            test          : 'VyaapaarRunner',
                            envName       : params.ENV,
                            suite         : params.SUITE,
                            udid          : params.ANDROID_UDID,
                            cucumberTags  : params.CUCUMBER_TAGS,
                            extraTags     : params.EXTRA_TAGS,
                            extraMaven    : '-Da11y.login.password=true -Dandroid.keep.session=true',
                            cleanReports  : params.CLEAN_PREVIOUS_REPORTS
                    ])
                    if (code != 0) {
                        currentBuild.result = 'UNSTABLE'
                        error "Tests failed (exit ${code})"
                    }
                }
            }
        }
    }

    post {
        always {
            script { if (helpers) { helpers.publishAllure(env.PRODUCT) } }
            archiveArtifacts artifacts: 'target/vyaapaar/**', allowEmptyArchive: true
            junit testResults: 'target/surefire-reports/airpay_vyaapaar/*.xml', allowEmptyResults: true
        }
    }
}
